<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Dependencies\**\*" />
    <EmbeddedResource Include="Dependencies\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- ===== UL.AUTOMATION PACKAGE(S) ===== -->
    
    <PackageReference Include="UL.Automation" Version="5.1.103" />
    <PackageReference Include="UL.Automation.Framework.NUnit" Version="5.1.103" />
    <PackageReference Include="UL.Automation.Reporting.Html" Version="5.1.103" />
    <PackageReference Include="UL.Automation.Reporting.ProgressDialog" Version="5.1.103" />
    <PackageReference Include="UL.Automation.SpecFlow" Version="5.1.103" />
    <PackageReference Include="UL.Automation.SpecFlow.Plugin.NUnit" Version="5.1.103" />
    <PackageReference Include="UL.Automation.TReVor" Version="5.1.103" />
    <PackageReference Include="UL.Automation.Utilities" Version="5.1.103" />
    <PackageReference Include="UL.Automation.Utilities.PDF" Version="5.1.103" />
    <PackageReference Include="UL.Automation.WebDriver" Version="5.1.103" />

    <!-- ===== TREVOR PACKAGE(S) ===== -->

    <PackageReference Include="TReVor.Integrations" Version="3.1.6" />
    <PackageReference Include="TReVor.Integrations.BuildOperations" Version="3.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- ===== SPECFLOW PACKAGE(S) ===== -->

    <PackageReference Include="SpecFlow" Version="3.9.74" />
    <PackageReference Include="SpecFlow.NUnit" Version="3.9.74" />
    <PackageReference Include="SpecFlow.Tools.MsBuild.Generation" Version="3.9.74" />

    <!-- ===== NUNIT PACKAGE(S) ===== -->

    <PackageReference Include="NUnit3TestAdapter" Version="3.16.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- ===== MISC. PACKAGE(S) ===== -->

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />    
    <PackageReference Include="itext7" Version="8.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />
    <!--<PackageReference Include="iTextSharp" Version="5.5.13.3" />-->
    <!--<PackageReference Include="Wercs.StyleCop.Settings" Version="3.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>-->

  </ItemGroup>

  <ItemGroup>
    <None Update="automationSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="specflow.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="wercsmartConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>