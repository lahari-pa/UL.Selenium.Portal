<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="trevorSettings" type="System.Configuration.NameValueSectionHandler" />
    <section name="reportSettings" type="System.Configuration.NameValueSectionHandler" />
    <section name="automationSettings" type="System.Configuration.NameValueSectionHandler" />
    <section name="utilitySettings" type="System.Configuration.NameValueSectionHandler" />
    <section name="specFlow" type="TechTalk.SpecFlow.Configuration.ConfigurationSectionHandler, TechTalk.SpecFlow" />

    
  </configSections>
  <connectionStrings />
  <appSettings>
    <add key="SoftwareBuild" value="Unknown" />
    <add key="LogsFolder" value="C:\UL.Automation" />
    <add key="AssemblyName" value="UL.Selenium.Portal.ChooseGoodGuide" />
  </appSettings>
  <reportSettings>
    <add key="ReportFolder" value="C:\Reports" />
    <add key="AssemblyName" value="UL.Selenium.Portal.ChooseGoodGuide" />
    <add key="ReportSubTitle" value="" />
    <add key="UseRunnerDialog" value="true" />
    <add key="ShowReportAtEndOfRun" value="true" />
    <add key="EnableSeasonalContent" value="true" />
    <add key="UseFullPageScreenshots" value="false" />
    <add key="ReportFormat" value="html" />
  </reportSettings>
  <automationSettings>
    <add key="TestUrl" value="https://www.ul.com/" />
    <add key="BrowserType" value="Chrome" />
    <add key="WebDriverFolder" value="C:\UL.Automation\WebDrivers" />
    <add key="DownloadsFolder" value="" />
    <add key="AutoDownloadPdf" value="false" />
    <add key="RunHeadless" value="false" />
    <add key="PageObjectTimeOutSeconds" value="1.0" />
  </automationSettings>
  <utilitySettings>
    <add key="AssemblyName" value="UL.Selenium.Portal.ChooseGoodGuide" />
    <add key="MailosaurPrefix" value="kxxyxunf" />
  </utilitySettings>
  <trevorSettings>
    <add key="AssemblyName" value="UL.Selenium.Portal.ChooseGoodGuide" />
    <add key="SoftwareBranch" value="Staging" />
    <add key="CacheFolder" value="" />
    <add key="TReVorApiEndpoint" value="https://trevor.global.ul.com/api/v1/" />
    <add key="ThomasApiEndpoint" value="https://thomas-service.global.ul.com/api/v1/" />
    <add key="VanessaApiEndpoint" value="https://trevor.global.ul.com:44306/api/v1/" />
    <add key="PublishResults" value="false" />
  </trevorSettings>
  <specFlow>
    <stepAssemblies>
      <stepAssembly assembly="UL.Selenium.Portal.WERCSmart" />
      <stepAssembly assembly="UL.Automation.Reporting.SpecFlow" />
      <stepAssembly assembly="UL.Automation.Selenium.SpecFlow" />
      <stepAssembly assembly="UL.Automation.TReVor.SpecFlow" />
      <stepAssembly assembly="UL.Automation.Utilities.SpecFlow" />
    </stepAssemblies>
    
  </specFlow>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.0" newVersion="4.2.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.InteropServices.RuntimeInformation" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.2.0" newVersion="4.0.2.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>