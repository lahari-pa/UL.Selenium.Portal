<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseReqnroll>true</UseReqnroll>
	</PropertyGroup>

	<ItemGroup>
		<!-- ===== UL.AUTOMATION PACKAGE(S) ===== -->

		<PackageReference Include="UL.Automation" Version="6.0.60" />
		<PackageReference Include="UL.Automation.Framework.NUnit" Version="6.0.60" />
		<PackageReference Include="UL.Automation.Reporting.Html" Version="6.0.60" />
		<PackageReference Include="UL.Automation.Reporting.ProgressDialog.WPF" Version="6.0.60" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
		<PackageReference Include="UL.Automation.TReVor" Version="6.0.60" />
		<PackageReference Include="UL.Automation.Utilities" Version="6.0.60" />
		<PackageReference Include="UL.Automation.Utilities.PDF" Version="6.0.60" />
		<PackageReference Include="UL.Automation.WebDriver" Version="6.0.60" />

		<!-- ===== TREVOR PACKAGE(S) ===== -->

		<PackageReference Include="TReVor.Integrations" Version="3.1.16" />
		<PackageReference Include="TReVor.Integrations.BuildOperations" Version="3.1.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- ===== REQNROLL PACKAGE(S) ===== -->

		<PackageReference Include="UL.Automation.Reqnroll" Version="6.0.60" Condition="'$(UseReqnroll)' == 'true'" />
		<PackageReference Include="UL.Automation.Reqnroll.Plugin.NUnit" Version="6.0.60" Condition="'$(UseReqnroll)' == 'true'" />
		<PackageReference Include="Reqnroll.NUnit" Version="2.2.1" Condition="'$(UseReqnroll)' == 'true'" />
		<PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="2.2.1" Condition="'$(UseReqnroll)' == 'true'" />

		<!-- ===== SPECFLOW PACKAGE(S) ===== -->

		<PackageReference Include="UL.Automation.ReqnrollHelpers" Version="5.2.17" Condition="'$(UseReqnroll)' == 'false'" />
		<PackageReference Include="UL.Automation.ReqnrollHelpers.Plugin.NUnit" Version="5.2.17" Condition="'$(UseReqnroll)' == 'false'" />
		<PackageReference Include="SpecFlow" Version="3.9.74" Condition="'$(UseReqnroll)' == 'false'" />
		<PackageReference Include="SpecFlow.NUnit" Version="3.9.74" Condition="'$(UseReqnroll)' == 'false'" />
		<PackageReference Include="SpecFlow.Tools.MsBuild.Generation" Version="3.9.74" Condition="'$(UseReqnroll)' == 'false'" />


		<!-- ===== NUNIT PACKAGE(S) ===== -->

		<PackageReference Include="NUnit3TestAdapter" Version="5.0.0-beta.7">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- ===== MISC. PACKAGE(S) ===== -->

		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="Wercs.StyleCop.Settings" Version="3.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\UL.Selenium.Portal.WERCSmart\UL.Selenium.Portal.WERCSmart.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="automationSettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="reqnroll.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
