    <add key="AnalyseStepBindings" value="false" />
  </appSettings>
  <trevorSettings>
    <add key="APIEndpoint" value="https://trevor.global.ul.com/api/v1" />
    <add key="Database" value="Data Source=TReVor.global.ul.com\SQLEXPRESS;Initial Catalog=TestRunDB;uid=sa;pwd=S7R23K8T22eh?;Integrated Security=False;Connection Timeout=120" />
