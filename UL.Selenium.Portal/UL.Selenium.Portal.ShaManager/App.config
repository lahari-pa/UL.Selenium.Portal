    <add key="BrowserRequired" value="true" />
    <add key="browser" value="Chrome" />
    <add key="RunHeaderless" value="false" />
    <add key="ShowReportAfterTest" value="true" />
    <add key="SiteType" value="Staging" />
    <add key="SiteEdition" value="Unknown" />
    <add key="DoPostBuild" value="true" />
    <add key="UseLocalCache" value="false" />
